#!/usr/bin/python3 -I
"""Stand-in for the `tuple` CLI, for the headless test session (dev/sandbox.sh).

It never talks to Tuple. Streams serve $TUPLE_MOCK_DIR/state.json,
contacts.json and rooms.json (re-emitted whenever a file changes, like the
real `follow` commands); every other command is appended to
$TUPLE_MOCK_DIR/commands.log and succeeds with `{}`.
"""
import json
import os
import sys
import time

MOCK_DIR = os.environ.get("TUPLE_MOCK_DIR") or os.path.dirname(os.path.abspath(__file__))

HELP = """Tuple CLI for managing contacts, calls, and application state.

Usage:
  tuple [command]

Available Commands:
  agent         Agent operating guidance and communication
  call          Call lifecycle
  capture       Capture and inspect call history
  connect       Connect an AI agent to Tuple
  contacts      People and availability
  machines      List your other connected machines
  notifications External call notifications
  rooms         Rooms and persistent spaces
  screen        Capture the shared screen
  start         Ensure the daemon is started
  state         Show current application state
  stop          Stop the daemon
  version       Print the app version
  webcam        List cameras, open the camera picker to share your webcam, and stop sharing it
  whoami        Print the authenticated user's identity

Deprecated Commands:
  set           Update a setting with the given value
  settings      List all settings and their values
  share         Share your screen
  unshare       Unshare your screen

Flags:
      --format format   output format: "text" or "json" (default text)
"""

CALL_HELP = """Call lifecycle

Usage:
  tuple call [command]

Available Commands:
  accept       Accept an incoming call
  edit         Edit a call's title or summary
  join         Join a call by person name or room URL
  leave        Leave the current call
  list         List ongoing calls
  lower-hand   Lower your raised hand
  mute         Mute your microphone
  participants Manage call participants
  raise-hand   Raise your hand on your webcam tile
  react        Send a reaction
  start        Start a call with someone or a machine ID from "machines list"
  unmute       Unmute your microphone

Flags:
  -h, --help   help for call
"""

REACT_HELP = """Send a reaction to everyone on the call.

Sounds play for everyone, yourself included: airhorn, trombone, flute.
Emoji show on your webcam tile: thumbs-up, plus-one, thumbs-down, clap, laugh, heart, tada, wow.
Animations play on your webcam tile: ship-it, table-flip, this-is-fine.

Usage:
  tuple call react <reaction> [flags]
"""

SETTINGS = """overlay | 1 | Show "overlay" annotation window when sharing screen (0|1)
start-calls-muted | 0 | Start with microphone muted when joining a call (0|1)
capture | portal | Screen capture mechanism (auto|x11|portal)
guest-mode | annotation | Current mode in screen window (annotation|control)
transcription-model |  | File path to whisper ggml model
webcam |  | Webcam device last picked"""


def path(name):
    return os.path.join(MOCK_DIR, name)


def read(name, default=None):
    try:
        with open(path(name)) as f:
            return f.read()
    except FileNotFoundError:
        return default


def follow(name):
    last = None
    while True:
        text = read(name)
        if text is not None and text != last:
            last = text
            print(json.dumps(json.loads(text)), flush=True)
        time.sleep(0.3)


def main():
    args = sys.argv[1:]
    if args[:2] == ["--format", "json"]:
        args = args[2:]
    elif "--format" in args:
        i = args.index("--format")
        args = args[:i] + args[i + 2:]

    if read("down.flag") is not None and args[-1:] != ["--help"] and args != ["start"]:
        print('{"error":"The Tuple app is not reachable"}')
        sys.exit(1)

    with open(path("commands.log"), "a") as log:
        log.write(" ".join(args) + "\n")

    if args in (["--help"], []):
        print(HELP)
    elif args == ["call", "--help"]:
        print(CALL_HELP)
    elif args == ["call", "react", "--help"]:
        print(REACT_HELP)
    elif args == ["state", "follow"]:
        follow("state.json")
    elif args == ["contacts", "follow"]:
        follow("contacts.json")
    elif args == ["rooms", "follow"]:
        follow("rooms.json")
    elif args == ["notifications", "follow"]:
        if not json.loads(read("state.json", "{}")).get("in_call"):
            print('{"error":"not in a call"}')
            return
        follow("notifications.json")
    elif args[:2] == ["call", "show"]:
        call = (json.loads(read("state.json", "{}")).get("call") or {})
        if not call:
            print('{"error":"not in a call"}')
            sys.exit(1)
        print(json.dumps({"id": call.get("call_id") or call.get("id"), "state": "active",
                          "title": read("call-title.txt") or None, "summary": None}))
    elif args[:2] == ["call", "edit"] and "--title" in args:
        with open(path("call-title.txt"), "w") as f:
            f.write(args[args.index("--title") + 1])
        print("{}")
    elif args[:2] == ["call", "list"]:
        print(read("calls.json", "[]"))
    elif args == ["whoami"]:
        print(json.dumps({"id": 1000, "email": "you@example.com", "full_name": "Alex Doe", "short_name": "Alex"}))
    elif args == ["settings"]:
        print(SETTINGS)
    elif args == ["version"]:
        print("v2026_11_19.0")
    elif args[:2] == ["machines", "list"]:
        print(read("machines.json", "[]"))
    elif args[:2] == ["capture", "list"]:
        print(read("captures.json", '{"error":"transcription store unavailable","error_code":503}'))
        if read("captures.json") is None:
            sys.exit(1)
    elif args[:2] == ["call", "start"]:
        # Simulate the callee not answering, to exercise exit status 2.
        time.sleep(0.5)
        print('{"outcome":"unanswered"}')
        sys.exit(2)
    else:
        print("{}")


if __name__ == "__main__":
    main()
